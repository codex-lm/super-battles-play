{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "super-battles/map@1",
  "title": "Super Battles battlefield v1",
  "type": "object",
  "required": ["schema", "name", "width", "height", "blocked", "cover", "objectives", "spawns"],
  "properties": {
    "schema": { "const": "super-battles/map@1" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "width": { "type": "integer", "minimum": 5, "maximum": 15 },
    "height": { "type": "integer", "minimum": 5, "maximum": 15 },
    "blocked": {
      "type": "array",
      "maxItems": 80,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tile" }
    },
    "cover": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tile" }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/tile" }
    },
    "spawns": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "$ref": "#/$defs/tile" }
      }
    }
  },
  "$defs": {
    "tile": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0, "maximum": 14 }
    }
  },
  "$comment": "The game additionally validates map bounds, obstacle overlaps, unique spawns and reachability of every objective from every spawn.",
  "additionalProperties": true
}
